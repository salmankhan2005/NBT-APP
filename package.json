{
  "name": "nbt-logistics-demo-suite",
  "version": "1.0.0",
  "description": "Zero-Database Interactive Client Demo Suite for NBT Logistics Admin and Driver Applications",
  "scripts": {
    "build": "node scripts/build-demo.js",
    "build:admin": "node scripts/build-admin-standalone.js",
    "build:driver": "node scripts/build-driver-standalone.js",
    "build:demo": "node scripts/build-demo.js",
    "preview": "npx --yes serve dist -p 3000",
    "deploy:vercel": "npx vercel --prod",
    "deploy:netlify": "npx netlify-cli deploy --prod --dir=dist",
    "demo:admin": "npm --prefix \"admin app\" run web",
    "demo:driver": "npm --prefix \"DRIVER APP\" run web -- --port 8082",
    "demo:backend": "npm --prefix \"backend\" run dev",
    "demo:open": "start demo-suite.html",
    "start": "npm run build && npm run preview"
  },
  "keywords": [
    "logistics",
    "demo",
    "fleet-management",
    "expo",
    "react-native",
    "fastify"
  ],
  "author": "NBT Logistics",
  "license": "ISC"
}
